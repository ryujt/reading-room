# Documentation only. `node scripts/reading-room.mjs init` generates real secrets
# in ../.local-rebuild/reading-room-r2/runtime.env with mode 0600.
DATABASE_URL=postgresql://reading_room:GENERATED_BY_INIT@127.0.0.1:54721/reading_room?schema=public
NEXTAUTH_SECRET=GENERATED_BY_INIT
NEXTAUTH_URL=http://127.0.0.1:4721/api/v1/auth
BASE_URL=http://127.0.0.1:4721
NEXT_PUBLIC_CREDENTIALS_ENABLED=true
NEXT_PUBLIC_DISABLE_REGISTRATION=false
NEXT_PUBLIC_EMAIL_PROVIDER=false
NEXT_PUBLIC_DEMO=false
STORAGE_FOLDER=../.local-rebuild/reading-room-r2/storage
MAX_WORKERS=1
ARCHIVE_TAKE_COUNT=2
BROWSER_TIMEOUT=2
ALLOW_PRIVATE_NETWORK_ACCESS=false
NEXT_TELEMETRY_DISABLED=1
